# ==============================================================================
# Raspcontrol-v3 Client Environment Configuration
# ==============================================================================

# Unique identifier for this hardware unit (Gateway/Tunnel ID)
GATEWAY_ID=your-gateway-id-here

# Secure authentication key/hash corresponding to the gateway's externalId
GATEWAY_TOKEN=your-secure-gateway-token-here

# Next.js Server WebSocket endpoint
SERVER_WS_URL=ws://localhost:3000/api/device/control

# Hardware operation mode: MOCK (simulate GPIO and 1-Wire sensors) or NATIVE (Raspberry Pi GPIO)
HARDWARE_MODE=MOCK

# Timezone settings for local scheduler evaluation
TIMEZONE=America/Mexico_City

# Logging verbosity: debug, info, warn, error
LOG_LEVEL=info
