# ==============================================================================
# Raspcontrol-v3 Client Environment Configuration
# ==============================================================================

# Identificador único del Gateway / Raspberry Pi asignado en la plataforma web
GATEWAY_ID=gateway-demo-01

# Token o clave de autenticación del dispositivo para validar conexión WebSocket
GATEWAY_TOKEN=your-secure-gateway-token-here

# URL del WebSocket del servidor central (ej. ws:// o wss://)
# Desarrollo: ws://localhost:3000/api/device/control
# Producción: wss://tu-dominio.com/api/device/control
SERVER_WS_URL=wss://app.tuempresa.com/api/device/control

# Modo de operación de hardware:
# NATIVE = Ejecución real en Raspberry Pi (acceso a GPIO, sensores 1-Wire y Modbus)
# MOCK   = Simulación para pruebas en PC/laptop sin hardware físico
HARDWARE_MODE=NATIVE

# Zona horaria para la evaluación de horarios locales (cron/schedules)
TIMEZONE=America/Mexico_City

# Nivel de detalle de logs: debug | info | warn | error
LOG_LEVEL=info

# ==============================================================================
# Intervalos de Temporización (Opcional - Valores por defecto en milisegundos)
# ==============================================================================
# Frecuencia de lectura de medidores de energía Modbus (60000 = 1 minuto)
ENERGY_INTERVAL_MS=60000

# Frecuencia de sincronización forzada del manifiesto (300000 = 5 minutos)
MANIFEST_SYNC_INTERVAL_MS=300000

# ==============================================================================
# Configuración Sensores de Temperatura 1-Wire DS18B20 (Opcional)
# ==============================================================================
# Cantidad de muestras tomadas para promediar y filtrar ruido
ONEWIRE_SAMPLES=5

# Retardo entre muestras en milisegundos
ONEWIRE_SAMPLE_DELAY_MS=1000

# Intentos máximos de lectura en caso de error
ONEWIRE_MAX_ATTEMPTS=3
